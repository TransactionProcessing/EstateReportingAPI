{
  "AllowedHosts": "*",
  "AppSettings": {
    "UseConnectionStringConfig": false,
    "DatabaseEngine": "SqlServer"
    //"DatabaseEngine": "MySql",
  },
  "SecurityConfiguration": {
    "ApiName": "estateReporting"
  },
  "UptimeKuma": {
    "Monitor": {
      "Name": "Estate Reporting",
      "Url": "http://localhost:5011/health",
      "IntervalInSeconds": 60
    }
  },
  "HealthMonitoring": {
    "Service": {
      "ServiceId": "estate-reporting-api",
      "Name": "Estate Reporting",
      "Description": "Estate Reporting",
      "HealthUrl": "http://localhost:5011/healthui"
    },
    "Dependencies": [
      {
        "DependencyName": "Read Model Server",
        "TargetServiceId": "sql-server"
      }
    ]
  }

}
